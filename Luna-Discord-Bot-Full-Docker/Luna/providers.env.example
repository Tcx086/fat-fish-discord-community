# Interface preparation only. All future providers below are NOT IMPLEMENTED.
# Keep the existing DeepSeek opt-in, credentials and limits; none are migrated.
# LLM_PROVIDER=deepseek

# Future generic chat-completions boundary. No requests can be made by this scaffold.
# LLM_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPATIBLE_MODEL=operator-chosen-model
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_TIMEOUT_MS=30000
# OPENAI_COMPATIBLE_MAX_TOKENS=256
# OPENAI_COMPATIBLE_STREAM=true
# OPENAI_COMPATIBLE_FEATURES=
# OPENAI_COMPATIBLE_CONTEXT_TOKENS=0
# Remote HTTPS requires an exact operator-approved origin (including non-default port).
# OPENAI_COMPATIBLE_ALLOWED_ORIGINS=https://operator-approved.example

# Future Ollama boundary; does not install/start Ollama or load a model.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=operator-chosen-model
# OLLAMA_API_KEY=
# OLLAMA_TIMEOUT_MS=30000
# OLLAMA_MAX_TOKENS=256
# OLLAMA_STREAM=true
# OLLAMA_FEATURES=
# OLLAMA_CONTEXT_TOKENS=0
# OLLAMA_ALLOWED_ORIGINS=

# Future LM Studio chat-completions boundary. Not used by legacy Luna.
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=operator-loaded-model
# LMSTUDIO_API_KEY=
# LMSTUDIO_TIMEOUT_MS=30000
# LMSTUDIO_MAX_TOKENS=256
# LMSTUDIO_STREAM=true
# LMSTUDIO_FEATURES=
# LMSTUDIO_CONTEXT_TOKENS=0
# LMSTUDIO_ALLOWED_ORIGINS=

# Existing legacy Luna mode remains a separate opt-in using answer-llm.js.
# LLM_PROVIDER=lmstudio
# LM_STUDIO_URL=http://127.0.0.1:1234/api/v1/chat
# LM_STUDIO_MCP_BEARER_TOKEN=
