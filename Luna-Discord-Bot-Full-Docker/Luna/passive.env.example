# Inert example; do not copy credentials here or enable without a new live-session approval.
CONVERSATION_ENABLED=false
CONVERSATION_MODE=passive
CONVERSATION_GUILD_ID=
# v0.3: /join selects your current voice channel; no fixed channel ID is needed.
# /move channel:<voice-channel> requires ManageGuild or a configured operator.
CONVERSATION_ALL_PARTICIPANTS=true
CONVERSATION_OPERATOR_IDS=
CONVERSATION_REGISTER_COMMANDS=false
# Dynamic passive sessions ignore automatic-join configuration.
CONVERSATION_CONTEXT_MS=180000
CONVERSATION_CONTEXT_ENTRIES=40
CONVERSATION_CONTEXT_CHARS=6000
CONVERSATION_QUESTION_MS=8000
CONVERSATION_PENDING=6
CONVERSATION_STT_TIMEOUT_MS=15000
CONVERSATION_STALE_MS=15000
CONVERSATION_REQUEST_LIMIT=6
LLM_PROVIDER=deepseek
DEEPSEEK_ENABLED=false
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=128
DEEPSEEK_RETRIES=0
DEEPSEEK_CONCURRENCY=1
DEEPSEEK_SESSION_TOKENS=16000
DEEPSEEK_DAILY_TOKENS=16000
DEEPSEEK_QUERY_BYTES=4096
WHISPER_SERVER_URLS=http://127.0.0.1:18082/inference
OWW_ENABLED=false
WAKE_SHADOW=false
WAKE_WHISPER_BACKUP=false
GREET_ON_JOIN=off
ANNOUNCE_SELF=false
# Character adapter; supply the model separately.
TTS_PROVIDER=feiyu
TTS_FALLBACK=none
FEIYU_TTS_URL=http://127.0.0.1:18882/v1/audio/speech
KOKORO_VOICE=af_heart
