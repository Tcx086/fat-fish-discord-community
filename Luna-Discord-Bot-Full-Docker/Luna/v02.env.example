# Inert configuration; does not authorize account connections or API expenditure.
FAT_FISH_TEXT_ENABLED=false
FAT_FISH_TEXT_REGISTER_COMMANDS=false
FAT_FISH_TEXT_GUILD_ID=
FAT_FISH_TEXT_CHANNEL_ID=
FAT_FISH_TEXT_USERS=
FAT_FISH_TEXT_OPERATORS=
LOCAL_CHAT_USER=local-owner
# Keep the existing memory.env.example policy/encrypted-volume gates.
MEMORY_STORAGE_ENABLED=false
MEMORY_POLICY_REVIEWED=false
MEMORY_ENCRYPTED_STORAGE_CONFIRMED=false
MEMORY_RETENTION_MS=86400000
MEMORY_SUMMARY_RETENTION_MS=86400000
DEEPSEEK_ENABLED=false
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_RETRIES=0
SEARCH_ENABLED=false
# Additional paid, tool-free text model request per successful search; requires DEEPSEEK_RETRIES=0.
SEARCH_SYNTHESIS_ENABLED=false
SEARCH_RESULT_LIMIT=3
SEARCH_TURN_BUDGET=1
SEARCH_PROCESS_BUDGET=10
SEARCH_TIMEOUT_MS=8000
SEARCH_RETRIES=0
# Empty by default. Fetch is not automatically orchestrated. See docs/SEARCH_TOOLS.md.
SEARCH_FETCH_ORIGINS=
# Supply DEEPSEEK_API_KEY privately to the process; never put a real key in this file.
