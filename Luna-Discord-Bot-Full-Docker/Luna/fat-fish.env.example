# Inert profile. Supply credentials only through the environment or ignored .env.
DISCORD_TOKEN=
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
DEEPSEEK_ENABLED=false
DEEPSEEK_RETRIES=0
DEEPSEEK_MAX_TOKENS=128
CONVERSATION_ENABLED=false
CONVERSATION_MODE=passive
CONVERSATION_GUILD_ID=
CONVERSATION_CHANNEL_ID=
CONVERSATION_ALL_PARTICIPANTS=false
CONVERSATION_USER_IDS=
CONVERSATION_OPERATOR_IDS=
CONVERSATION_REGISTER_COMMANDS=false
CONVERSATION_REQUEST_LIMIT=6
DEEPSEEK_CONCURRENCY=1
DEEPSEEK_SESSION_TOKENS=16000
DEEPSEEK_DAILY_TOKENS=16000
DEEPSEEK_QUERY_BYTES=4096
MEMORY_STORAGE_ENABLED=false
TTS_PROVIDER=feiyu
FEIYU_TTS_URL=http://127.0.0.1:18882/v1/audio/speech
FEIYU_TTS_TIMEOUT_MS=120000
TTS_FALLBACK=none
WHISPER_SERVER_URLS=http://127.0.0.1:18082/inference
OWW_ENABLED=false
WAKE_SHADOW=false
WAKE_WHISPER_BACKUP=false
WAKE_LOG_FILE=
GREET_ON_JOIN=off
ANNOUNCE_SELF=false
AUTO_JOIN_CHANNELS=
TEXT_CHAT_CHANNELS=
LLM_TOOLS=false
