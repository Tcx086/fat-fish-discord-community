# Inert example. This does not authorize Discord login, registration or paid calls.
MEMORY_STORAGE_ENABLED=false
MEMORY_POLICY_REVIEWED=false
MEMORY_ENCRYPTED_STORAGE_CONFIRMED=false
# Publish the real app privacy/deletion/support policy and add it to the Developer Portal before enabling.
MEMORY_PRIVACY_URL=https://example.invalid/privacy
# Default: <Luna>/data/memory.sqlite (gitignored). Use a private encrypted volume in production.
# MEMORY_DB_PATH=/absolute/path/to/encrypted-data/memory.sqlite
MEMORY_RETENTION_MS=86400000
# Explicit calendar offset for "yesterday"; UTC by default. Adjust when DST changes.
MEMORY_UTC_OFFSET_MINUTES=0
MEMORY_TOTAL_TOKENS=8192
MEMORY_IDENTITY_BYTES=3000
MEMORY_WORKING_TOKENS=1200
MEMORY_EPISODE_TOKENS=1000
MEMORY_APPROVED_TOKENS=500
# Character directory defaults to <Luna>/character; reload through /memory action:reload-character.
CONVERSATION_ENABLED=false
CONVERSATION_MODE=passive
CONVERSATION_REGISTER_COMMANDS=false
DEEPSEEK_ENABLED=false
