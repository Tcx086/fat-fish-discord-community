# Append these settings to the existing private .env; do not replace its voice/privacy settings.
MUSIC_ENABLED=false
# Defaults to CONVERSATION_GUILD_ID when omitted.
# MUSIC_GUILD_ID=123456789012345678
# Default directory: <home>/Music/FatFish, outside the checkout.
# MUSIC_DIRECTORY=/absolute/path/to/authorized-music
# MUSIC_CATALOG=/absolute/path/to/authorized-music/catalog.json
MUSIC_FFMPEG=ffmpeg
MUSIC_FFPROBE=ffprobe
MUSIC_MAX_QUEUE=20
MUSIC_MAX_FILE_MB=100
MUSIC_MAX_DURATION_SECONDS=900
MUSIC_VOLUME=30
# Registration happens only on a separately authorized live Discord startup.
MUSIC_REGISTER_COMMANDS=false
